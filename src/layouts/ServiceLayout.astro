---
import Layout from './Layout.astro';

interface Props {
  title: string;          // Para el <title> de la pestaña
  description: string;    // Para el meta description de SEO
  h1: string;             // Título principal con la Keyword
  heroImage: string;      // Imagen de fondo del Hero
  h2: string;             // Título del bloque de contenido
  introText: string;      // Bajada del Hero
  whatsappMessage?: string; // Texto personalizado para WhatsApp
  videos?: string[];      // Lista de URLs de videos (.mp4)
  images?: string[];      // 3 imágenes para la galería inferior
}

const {
  title,
  description,
  h1,
  heroImage,
  h2,
  introText,
  whatsappMessage = "Hola! Quiero probar una clase gratis",
  videos = [],
  images = []
} = Astro.props;

const encodedMessage = encodeURIComponent(whatsappMessage);
---

<Layout title={title} description={description}>
  <!-- 1. HERO DE LA PÁGINA INTERNA (Alineado a la izquierda) -->
  <section class="relative min-h-[70vh] flex items-center bg-gray-950 text-white pt-28 pb-20 overflow-hidden">
    <!-- Imagen de fondo con overlay oscuro -->
    <div 
      class="absolute inset-0 bg-cover bg-center opacity-40 transform scale-105 transition-transform duration-1000"
      style={`background-image: url('${heroImage}');`}
    >
      <div class="absolute inset-0 bg-gradient-to-r from-[#09090b] via-[#09090b]/80 to-transparent"></div>
    </div>

    <!-- Contenido del Hero alineado a la izquierda -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="max-w-3xl">
        <h1 class="reveal active text-3xl sm:text-5xl lg:text-6xl font-black text-white font-heading uppercase tracking-tight mb-6 leading-tight" style="transition-delay: 100ms;">
          {h1}
        </h1>

        <p class="reveal active text-gray-300 text-base sm:text-xl font-light leading-relaxed mb-8" style="transition-delay: 200ms;">
          {introText}
        </p>

        <div class="reveal active flex justify-start" style="transition-delay: 300ms;">
          <a 
            href={`https://wa.me/5491144372491?text=${encodedMessage}`}
            target="_blank" 
            rel="noopener noreferrer"
            class="bg-[#639A2B] hover:bg-[#7cb83c] text-white font-bold px-8 py-4 rounded-xl text-xs sm:text-sm uppercase tracking-wider transition-all shadow-lg shadow-[#639A2B]/20 flex items-center gap-2 group"
          >
            <span>¡Quiero probar una clase GRATIS!</span>
            <span class="transform group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. BLOQUE DE CONTENIDO PRINCIPAL + VIDEOS + GALERÍA DE 3 IMÁGENES -->
  <section class="py-20 bg-white text-gray-900 border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Columna de Texto explicativo -->
        <div class={`space-y-6 ${videos.length > 0 ? 'lg:col-span-6' : 'lg:col-span-8 lg:mx-auto'}`}>
          <h2 class="reveal text-2xl sm:text-4xl font-black font-heading text-[#17239C] uppercase tracking-tight leading-tight">
            {h2}
          </h2>

          <div class="reveal text-gray-600 text-base sm:text-lg leading-relaxed space-y-4">
            <slot /> <!-- Aquí entra el contenido específico de cada servicio -->
          </div>
        </div>

        <!-- Columna de Videos (Si se proveen) -->
        {videos.length > 0 && (
          <div class="lg:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
            {videos.map((videoSrc, index) => (
              <div 
                class="reveal relative rounded-2xl overflow-hidden bg-gray-900 shadow-xl aspect-[9/16] border border-gray-100"
                style={`transition-delay: ${index * 150}ms;`}
              >
                <video 
                  src={videoSrc}
                  autoplay 
                  loop 
                  muted 
                  playsinline 
                  class="w-full h-full object-cover"
                ></video>
              </div>
            ))}
          </div>
        )}

      </div>

<!-- 3. GALERÍA DE 3 IMÁGENES INFERIOR -->
      {images.length > 0 && (
        <div class="mt-8 pt-8 md:mt-20 md:pt-16 md:border-t border-gray-100">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
            {images.map((imgSrc, index) => (
              <div 
                class="reveal relative rounded-2xl overflow-hidden shadow-lg aspect-[4/3] group bg-gray-100 border border-gray-200"
                style={`transition-delay: ${index * 150}ms;`}
              >
                <img 
                  src={imgSrc} 
                  alt="Instalaciones o entrenamiento en CAFA Adrogué" 
                  class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
      )}

    </div>
  </section>
</Layout>