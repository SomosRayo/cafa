---
const services = [
  // Fila 1 (4 tarjetas en Desktop)
  {
    title: "Funcional y gimnasio",
    image: "/images/funcional.jpg",
    href: "/funcional-gimnasio",
    desktopSpan: "lg:col-span-3",
    tabletSpan: "md:col-span-6",
    delay: "0ms",
  },
  {
    title: "Entrenamiento para fútbol",
    image: "/images/entrenamiento-para-futbol-amateur-adultos.jpg",
    href: "/entrenamiento-futbol",
    desktopSpan: "lg:col-span-3",
    tabletSpan: "md:col-span-6",
    delay: "100ms",
  },
  {
    title: "Gimnasia para adultos mayores",
    image: "/images/adultos-mayores.jpg",
    href: "/adultos-mayores",
    desktopSpan: "lg:col-span-3",
    tabletSpan: "md:col-span-6",
    delay: "200ms",
  },
  {
    title: "Entrenamiento infantil (Kids)",
    image: "/images/entrenamiento-infantil-para-niños-y-niñas-menores.jpg",
    href: "/kids",
    desktopSpan: "lg:col-span-3",
    tabletSpan: "md:col-span-6",
    delay: "300ms",
  },
  // Fila 2 (3 tarjetas más anchas en Desktop)
  {
    title: "Yoga",
    image: "/images/yoga.jpg",
    href: "/yoga",
    desktopSpan: "lg:col-span-4",
    tabletSpan: "md:col-span-6",
    delay: "100ms",
  },
  {
    title: "Masajes descontracturantes",
    image: "/images/masajes-descontracturantes-cuerpo-completo.jpg",
    href: "/masajes",
    desktopSpan: "lg:col-span-4",
    tabletSpan: "md:col-span-6",
    delay: "200ms",
  },
  {
    title: "Antropometría",
    image: "/images/antropometria.jpg",
    href: "/antropometria",
    desktopSpan: "lg:col-span-4",
    tabletSpan: "md:col-span-12 md:max-w-xl md:mx-auto w-full",
    delay: "300ms",
  },
];
---

<!-- SECCIÓN CON FONDO BLANCO -->
<section class="py-24 bg-white text-gray-900 border-t border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de la sección con animación reveal -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="reveal">
        <span class="text-xs uppercase tracking-widest text-[#639A2B] font-bold block mb-2">Nuestras Actividades</span>
        <h2 class="text-3xl sm:text-5xl font-black font-heading tracking-tight text-[#17239C]">
          ENCONTRÁ TU FORMA <br />DE ENTRENAR
        </h2>
      </div>
      <p class="reveal text-gray-600 text-sm sm:text-base max-w-md leading-relaxed" style="transition-delay: 200ms;">
        Una propuesta integral para que trabajes tu cuerpo, tu salud y tu bienestar con profesionales capacitados.
      </p>
    </div>

    <!-- Grid simétrico basado en 12 columnas -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      {services.map((service) => (
        <a 
          href={service.href}
          class={`reveal group relative h-80 rounded-2xl overflow-hidden bg-gray-900 border border-gray-200 hover:border-[#639A2B] transition-all duration-300 shadow-xl flex flex-col justify-end p-6 ${service.tabletSpan} ${service.desktopSpan}`}
          style={`transition-delay: ${service.delay};`}
        >
          <!-- Imagen de fondo con zoom suave al hacer hover -->
          <div 
            class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105 opacity-70"
            style={`background-image: url('${service.image}');`}
          >
            <!-- Degradado oscuro para asegurar lectura perfecta del texto blanco sobre la foto -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
          </div>

          <!-- Contenido de la tarjeta (Título blanco y Flecha) -->
          <div class="relative z-10 flex items-end justify-between w-full">
            <h3 class="text-lg sm:text-xl font-bold font-heading uppercase text-white tracking-wide pr-4">
              {service.title}
            </h3>
            
            <!-- Flecha interactiva con iluminación en verde C.A.F.A. -->
            <div class="w-10 h-10 rounded-full bg-white/10 backdrop-blur-md flex items-center justify-center text-white group-hover:bg-[#639A2B] transition-colors shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>