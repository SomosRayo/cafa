---
---
<footer class="bg-[#09090b] text-white border-t border-white/10 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Grilla principal de 3 columnas (25% - 25% - 50% en PC) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 mb-12 items-start">
      
      <!-- Columna 1: Logo más grande, Descripción y Redes Sociales (Ocupa 3 de 12 col = 25%) -->
      <div class="lg:col-span-3 space-y-6">
        <a href="/" class="flex items-center">
          <img 
            src="/images/cafa-logo-blanco-fondo-transparente.png" 
            alt="C.A.F.A. Adrogué" 
            class="h-14 w-auto object-contain"
          />
        </a>
        <p class="text-gray-400 text-sm leading-relaxed">
          Tu espacio de acondicionamiento físico, salud y rendimiento en Adrogué. Entrenamiento personalizado y un ambiente donde te sentís parte.
        </p>

        <!-- Iconos de Redes Sociales juntos (Instagram, Facebook, WhatsApp) -->
        <div class="flex items-center gap-3 pt-2">
          <!-- Instagram -->
          <a 
            href="https://www.instagram.com/cafaadrogue" 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label="Instagram"
            class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-gray-300 hover:text-white hover:bg-[#639A2B] hover:border-[#639A2B] transition-all"
          >
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>

          <!-- Facebook -->
          <a 
            href="https://www.facebook.com/cafaadrogue/" 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label="Facebook"
            class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-gray-300 hover:text-white hover:bg-[#639A2B] hover:border-[#639A2B] transition-all"
          >
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"/>
            </svg>
          </a>

          <!-- WhatsApp -->
          <a 
            href="https://wa.me/5491144372491" 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label="WhatsApp"
            class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-gray-300 hover:text-white hover:bg-[#639A2B] hover:border-[#639A2B] transition-all"
          >
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M17.472 14.382c-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.375l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Columna 2: Ubicación y Horarios (Sin WhatsApp, Ocupa 3 de 12 col = 25%) -->
      <div class="lg:col-span-3 space-y-4">
        <h3 class="text-xs uppercase tracking-widest text-[#639A2B] font-bold font-heading">
          Ubicación y Contacto
        </h3>
        
        <ul class="space-y-3 text-sm text-gray-300">
          <!-- Dirección con ícono de mapa en verde -->
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-[#639A2B] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Diag. Toll 1386, B1846 Adrogué, Provincia de Buenos Aires</span>
          </li>

          <!-- Horarios con ícono de reloj en verde -->
          <li class="flex items-start gap-3 pt-1">
            <svg class="w-5 h-5 text-[#639A2B] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Lun a Vie: 7:00 a 21:30 <br/> Sáb: 9:00 a 11:00</span>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Mapa de Google Maps Incrustado (Ocupa 6 de 12 col = 50%) -->
      <div class="lg:col-span-6">
        <div class="w-full h-64 sm:h-72 rounded-2xl overflow-hidden border border-white/10 shadow-xl bg-gray-900">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3276.1627969441197!2d-58.38989017428508!3d-34.801845902753406!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95bcd3466f4bb6c7%3A0x336d658fb7a6049!2sC.A.F.A.!5e0!3m2!1ses!2sar!4v1793115636205!5m2!1ses!2sar" 
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="strict-origin-when-cross-origin">
          </iframe>
        </div>
      </div>

    </div>

    <!-- Barra inferior solo con Copyright (Sin links de términos/privacidad) -->
    <div class="pt-8 mt-8 border-t border-white/5 text-center sm:text-left text-xs text-gray-500">
      <p>© 2026 C.A.F.A. Adrogué. Todos los derechos reservados.</p>
    </div>

  </div>
</footer>