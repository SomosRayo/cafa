---
const navLinks = [
  { name: "Funcional", href: "/funcional-gimnasio" },
  { name: "Fútbol", href: "/entrenamiento-futbol" },
  { name: "Adultos Mayores", href: "/adultos-mayores" },
  { name: "Kids", href: "/kids" },
  { name: "Yoga", href: "/yoga" },
  { name: "Masajes", href: "/masajes" },
  { name: "Antropometría", href: "/antropometria" },
];
---

<header style="position: sticky; top: 0; z-index: 999; background-color: #09090b; border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    
    <!-- Logo -->
    <div class="flex-1 lg:flex-none flex justify-center lg:justify-start">
      <a href="/" class="flex items-center">
        <img 
          src="/images/C.A.F.A. Gimnasio en Adrogue logo.png" 
          alt="C.A.F.A. Gimnasio en Adrogué" 
          class="h-10 w-auto object-contain"
        />
      </a>
    </div>

    <!-- Menú Desktop Centrado -->
    <nav class="hidden lg:flex items-center space-x-6 text-sm font-medium text-gray-300">
      {navLinks.map((link) => (
        <a href={link.href} class="hover:text-[#639A2B] transition-colors uppercase tracking-wider text-xs">
          {link.name}
        </a>
      ))}
    </nav>

    <!-- Botón WhatsApp Desktop (Con el ícono oficial correcto) -->
    <div class="hidden lg:flex items-center">
      <a 
        href="https://wa.me/5491144372491?text=Hola!%20Quiero%20consultar%20por%20las%20actividades%20en%20CAFA%20Adrogué" 
        target="_blank" 
        rel="noopener noreferrer"
        class="bg-[#25D366] hover:bg-[#20ba5a] text-white px-4 py-2.5 rounded-xl font-bold text-xs uppercase tracking-wider flex items-center gap-2 transition-all shadow-lg"
      >
        <!-- Ícono Verdadero de WhatsApp -->
        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M17.472 14.382c-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.375l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>Consultá por WhatsApp</span>
      </a>
    </div>

    <!-- Menú Hamburguesa (Mobile) -->
    <div class="lg:hidden flex items-center">
      <button id="menu-btn" aria-label="Abrir menú" class="text-white focus:outline-none p-2">
        <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Menú Desplegable Mobile -->
  <div id="mobile-menu" class="hidden lg:hidden bg-[#09090b] border-b border-white/10 px-6 pt-4 pb-6 space-y-3">
    {navLinks.map((link) => (
      <a href={link.href} class="block text-gray-300 hover:text-[#639A2B] font-semibold text-sm uppercase py-2 border-b border-white/5">
        {link.name}
      </a>
    ))}
    <div class="pt-4">
      <a 
        href="https://wa.me/5491144372491?text=Hola!%20Quiero%20consultar%20por%20las%20actividades%20en%20CAFA%20Adrogué" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-full bg-[#25D366] text-white py-3 rounded-xl font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-2 shadow-lg"
      >
        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M17.472 14.382c-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.375l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>Consultá por WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>